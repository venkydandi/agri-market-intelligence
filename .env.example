# ─── Server ───────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (replace with your own M0 cluster URI)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agri-route?retryWrites=true&w=majority

# JWT secret key (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Server port
PORT=5000

# Client origin (for CORS)
CLIENT_URL=http://localhost:5173

# ─── Phase 3+ (not needed for Phase 1) ──────────────────────────────────────
# Google Maps Distance Matrix API key
MAPS_API_KEY=

# OpenWeatherMap API key
WEATHER_API_KEY=
